document.addEventListener('DOMContentLoaded', () => {
  const forms = document.querySelectorAll('[data-cart-form]');

  forms.forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const submitButton = form.querySelector('button[type="submit"]');
      const originalText = submitButton?.textContent || 'Add to cart';

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'جاري الإضافة...';
      }

      try {
        const response = await fetch('/cart/add', {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' }
        });

        const result = await response.json();
        const badge = document.querySelector('.cart-badge');

        if (badge) {
          badge.textContent = result.cartCount || 0;
        }

        if (result.success) {
          form.closest('.product-card')?.scrollIntoView({ behavior: 'smooth' });
          const toast = document.createElement('div');
          toast.className = 'flash success';
          toast.textContent = result.message;
          document.body.prepend(toast);
          setTimeout(() => toast.remove(), 2000);
        } else {
          const toast = document.createElement('div');
          toast.className = 'flash error';
          toast.textContent = result.message || 'حدث خطأ.';
          document.body.prepend(toast);
          setTimeout(() => toast.remove(), 2500);
        }
      } catch (error) {
        console.error(error);
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalText;
        }
      }
    });
  });
});
